{
  "name": "autoclip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Drop in a song and a pile of clips. AutoClip listens for the beats, builds and drops, finds the best moments in your footage and cuts a synced edit on its own.",
  "license": "MIT",
  "author": {
    "name": "Shariq",
    "email": "00khanshariq@gmail.com"
  },
  "homepage": "https://github.com/shariqsk/autoclip",
  "repository": {
    "type": "git",
    "url": "https://github.com/shariqsk/autoclip.git"
  },
  "main": "electron/main.mjs",
  "productName": "AutoClip",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "desktop": "pnpm build:desktop && electron .",
    "dist:desktop": "pnpm build:desktop && electron-builder"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.57.0",
    "mediabunny": "^1.61.4",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "dev.shariq.autoclip",
    "productName": "AutoClip",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "shariqsk",
        "repo": "autoclip",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "AutoClip-mac-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AutoClip-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "AutoClip-linux-${arch}.${ext}",
      "maintainer": "Shariq <00khanshariq@gmail.com>"
    }
  }
}
